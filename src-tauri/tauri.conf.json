{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VemuZ",
  "version": "1.0.1",
  "identifier": "com.vemuz.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VemuZ",
        "width": 900,
        "height": 600,
        "maximized": true,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#0D1120"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "fr-FR"
      },
      "nsis": {
        "languages": ["French"]
      }
    }
  }
}

